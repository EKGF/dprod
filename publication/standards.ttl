# Audience overview selects canonical content; it owns no parallel marketing copy.
doc:project ga:target doc:overview-pdf .
doc:overview-pdf a ga:Target ; dct:title "DPROD: the bigger picture" ;
    ga:subtitle "Shared meaning for data products" ;
    ga:publicationDate "2026-11-04"^^xsd:date ;
    dct:description "A practical introduction to DPROD, its core model, examples, and adoption path."@en ;
    ga:scope doc:overview-scope ; ga:profile doc:overview-profile ;
    ga:renderer ga:TypstRenderer ; ga:destination "pdf/overview" ;
