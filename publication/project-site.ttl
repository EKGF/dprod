@prefix ga: <https://ekgf.org/ontology/grapharch#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .

<urn:dprod:project-site> a ga:Project ;
    dct:title "DPROD" ;
    ga:repository <https://github.com/EKGF/dprod> ;
    ga:scope <urn:dprod:project-site:scope> ;
    ga:target <urn:dprod:project-site:website> .
<urn:dprod:project-site:scope> a ga:Scope .
<urn:dprod:project-site:website> a ga:Target ;
    dct:title "DPROD project website" ;
    ga:scope <urn:dprod:project-site:scope> ;
    ga:profile <urn:dprod:project-site:profile> ;
    ga:thisVersion <https://ekgf.org/dprod/> ;
    ga:renderer ga:WebsiteRenderer ; ga:destination "site" .
<urn:dprod:project-site:profile> a ga:Profile ;
    ga:style "ekgf-project" ;
    ga:headerLink <urn:dprod:project-site:specification> .
<urn:dprod:project-site:specification> dct:title "Specification" ;
    ga:url "spec-versions/" ; ga:order 1 .

<urn:dprod:project-site:versions-page> a ga:DocumentorUse ;
    ga:project <urn:dprod:project-site> ; ga:documentorType ga:PublicationInventoryDocumentor ;
    ga:subject <urn:dprod:project-site:versions> ;
    ga:fragment <urn:dprod:project-site:page:versions> ;
    dct:title "Specification versions" ; ga:route "spec-versions/" ;
    ga:sourcePath "spec-versions.md" ; ga:navigationOrder 6 .
<urn:dprod:project-site:page:versions> dct:description
    "Specifications rebuilt together from selected Git revisions: DPROD 1.0 beta, the latest working draft, and selected review branches. Draft previews are not standardized versions." .
