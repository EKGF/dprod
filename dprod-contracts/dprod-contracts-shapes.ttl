# baseURI: https://ekgf.github.io/dprod/contracts/shapes/
# imports: https://ekgf.github.io/dprod/contracts/
# imports: http://www.w3.org/ns/shacl#
# prefix: dprod-shapes

@base <https://ekgf.github.io/dprod/contracts/shapes/> .
@prefix dprod-shapes: <https://ekgf.github.io/dprod/contracts/shapes/> .
@prefix dprod: <https://ekgf.github.io/dprod/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dprod-shapes:
  a owl:Ontology ;
  dct:title "Shapes for DPROD Data Contracts"@en ;
  rdfs:label "DPROD contracts shapes"@en ;
  dct:description "SHACL validation shapes for DPROD data contract policies."@en ;
  rdfs:comment
    "This is intended to be used with SHACL, not as an ontology: the ontology element is to provide the metadata for the set of shapes."@en ;
  dct:license <https://creativecommons.org/licenses/by/4.0/> ;
  dct:modified "2026-02-26"^^xsd:date ;
  owl:imports <https://ekgf.github.io/dprod/contracts/> ;
  owl:imports sh: ;
  owl:versionInfo "0.7" ;
  sh:declare [
    sh:prefix "dprod" ;
    sh:namespace "https://ekgf.github.io/dprod/" ;
  ] ;
  sh:declare [
    sh:prefix "dprod-shapes" ;
    sh:namespace "https://ekgf.github.io/dprod/contracts/shapes/" ;
  ] ;
  sh:declare [
    sh:prefix "odrl" ;
    sh:namespace "http://www.w3.org/ns/odrl/2/" ;
  ] ;
.


############################# Reusable Property Groups #########################


dprod-shapes:StatePropertyGroup
  sh:path dprod:state ;
  sh:maxCount 1 ;
  sh:in (dprod:Pending dprod:Active dprod:Fulfilled dprod:Violated) ;
  sh:message "State must be Pending, Active, Fulfilled, or Violated." ;
.

dprod-shapes:ProfilePropertyGroup
  sh:path odrl:profile ;
  sh:minCount 1 ;
  sh:hasValue <https://ekgf.github.io/dprod/> ;
  sh:message "DPROD policies must declare odrl:profile <https://ekgf.github.io/dprod/>." ;
.

dprod-shapes:NonEmptyClausesConstraint
  a sh:NodeShape ;
  sh:or (
    [ sh:property [ sh:path odrl:permission ; sh:minCount 1 ] ]
    [ sh:property [ sh:path odrl:prohibition ; sh:minCount 1 ] ]
    [ sh:property [ sh:path odrl:obligation ; sh:minCount 1 ] ]
  ) ;
  sh:message "Policy must have at least one permission, prohibition, or obligation." ;
.


############################# Policy Shapes #########################


dprod-shapes:PolicyShape
  a sh:NodeShape ;
  rdfs:isDefinedBy dprod-shapes: ;
  rdfs:label "policy shape" ;
  sh:targetClass odrl:Policy ;
  sh:name "Policy Shape" ;
  sh:property [
    sh:path odrl:profile ;
    sh:minCount 1 ;
    sh:hasValue <https://ekgf.github.io/dprod/> ;
    sh:message "DPROD policies must declare odrl:profile <https://ekgf.github.io/dprod/>."
  ] ;
.

dprod-shapes:SetShape
  a sh:NodeShape ;
  rdfs:isDefinedBy dprod-shapes: ;
  rdfs:label "set shape" ;
  sh:targetClass odrl:Set ;
  sh:name "Set Shape" ;
  sh:property dprod-shapes:ProfilePropertyGroup ;
  sh:node dprod-shapes:NonEmptyClausesConstraint ;
  sh:property [
    sh:path odrl:target ;
    sh:message "Set policy may declare a policy-level target (inherited by rules)."
  ] ;
.

dprod-shapes:OfferShape
  a sh:NodeShape ;
  rdfs:isDefinedBy dprod-shapes: ;
  rdfs:label "offer shape" ;
  sh:targetClass odrl:Offer ;
  sh:name "Offer Shape" ;
  sh:property dprod-shapes:ProfilePropertyGroup ;
  sh:node dprod-shapes:NonEmptyClausesConstraint ;
  sh:property [
    sh:path odrl:assigner ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Offer must have exactly one assigner."
  ] ;
.

dprod-shapes:AgreementShape
  a sh:NodeShape ;
  rdfs:isDefinedBy dprod-shapes: ;
  rdfs:label "agreement shape" ;
  sh:targetClass odrl:Agreement ;
  sh:name "Agreement Shape" ;
  sh:property dprod-shapes:ProfilePropertyGroup ;
  sh:node dprod-shapes:NonEmptyClausesConstraint ;
  sh:property [
    sh:path odrl:assigner ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Agreement must have exactly one assigner."
  ] ;
  sh:property [
    sh:path odrl:assignee ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Agreement must have exactly one assignee."
  ] ;
.


############################# Rule Shapes #########################


dprod-shapes:PermissionShape
  a sh:NodeShape ;
  rdfs:isDefinedBy dprod-shapes: ;
  rdfs:label "permission shape" ;
  sh:targetClass odrl:Permission ;
  sh:name "Permission Shape" ;
  sh:property [
    sh:path odrl:action ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Permission must have exactly one action."
  ] ;
  sh:property [
    sh:path odrl:target ;
    sh:maxCount 1 ;
    sh:message "Permission may have at most one target (inherits from policy if absent)."
  ] ;
.

dprod-shapes:ProhibitionShape
  a sh:NodeShape ;
  rdfs:isDefinedBy dprod-shapes: ;
  rdfs:label "prohibition shape" ;
  sh:targetClass odrl:Prohibition ;
  sh:name "Prohibition Shape" ;
  sh:property [
    sh:path odrl:action ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Prohibition must have exactly one action."
  ] ;
  sh:property [
    sh:path odrl:target ;
    sh:maxCount 1 ;
    sh:message "Prohibition may have at most one target (inherits from policy if absent)."
  ] ;
.

dprod-shapes:DutyShape
  a sh:NodeShape ;
  rdfs:isDefinedBy dprod-shapes: ;
  rdfs:label "duty shape" ;
  sh:targetClass odrl:Duty ;
  sh:name "Duty Shape" ;
  sh:property [
    sh:path odrl:action ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Duty must have exactly one action."
  ] ;
  sh:property [
    sh:path dprod:deadline ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype xsd:dateTime ]
      [ sh:datatype xsd:duration ]
    ) ;
    sh:message "Deadline must be xsd:dateTime or xsd:duration."
  ] ;
  sh:property [
    sh:path dprod:recurrence ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^FREQ=(SECONDLY|MINUTELY|HOURLY|DAILY|WEEKLY|MONTHLY|YEARLY)" ;
    sh:message "Recurrence must be a valid RFC 5545 RRULE starting with FREQ=."
  ] ;
  sh:property [
    sh:path dprod:subject ;
    sh:maxCount 1 ;
    sh:class odrl:Party ;
    sh:message "Duty subject must be a single odrl:Party."
  ] ;
  sh:property [
    sh:path dprod:object ;
    sh:maxCount 1 ;
    sh:class odrl:Party ;
    sh:message "Duty object must be a single odrl:Party."
  ] ;
  sh:property dprod-shapes:StatePropertyGroup ;
.


############################# Constraint Shapes #########################


dprod-shapes:ConstraintShape
  a sh:NodeShape ;
  rdfs:isDefinedBy dprod-shapes: ;
  rdfs:label "constraint shape" ;
  sh:targetClass odrl:Constraint ;
  sh:name "Constraint Shape" ;
  sh:property [
    sh:path odrl:leftOperand ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Constraint must have exactly one leftOperand."
  ] ;
  sh:property [
    sh:path odrl:operator ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Constraint must have exactly one operator."
  ] ;
  sh:property [
    sh:path odrl:rightOperand ;
    sh:minCount 1 ;
    sh:message "Constraint must have a rightOperand."
  ] ;
.

dprod-shapes:LogicalConstraintShape
  a sh:NodeShape ;
  rdfs:isDefinedBy dprod-shapes: ;
  rdfs:label "logical constraint shape" ;
  sh:targetClass odrl:LogicalConstraint ;
  sh:name "Logical Constraint Shape" ;
  sh:xone (
    [ sh:property [ sh:path odrl:and ; sh:minCount 1 ; sh:maxCount 1 ] ]
    [ sh:property [ sh:path odrl:or ; sh:minCount 1 ; sh:maxCount 1 ] ]
    [ sh:property [ sh:path dprod:not ; sh:minCount 1 ; sh:maxCount 1 ] ]
  ) ;
  sh:message "LogicalConstraint must have exactly one of: odrl:and, odrl:or, or dprod:not." ;
.


############################# Contract Shapes #########################


dprod-shapes:DataOfferShape
  a sh:NodeShape ;
  rdfs:isDefinedBy dprod-shapes: ;
  rdfs:label "data offer shape" ;
  sh:targetClass dprod:DataOffer ;
  sh:name "Data Offer Shape" ;
  sh:property dprod-shapes:ProfilePropertyGroup ;
  sh:node dprod-shapes:NonEmptyClausesConstraint ;
  sh:property [
    sh:path odrl:assigner ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "DataOffer must have exactly one assigner."
  ] ;
  sh:property dprod-shapes:StatePropertyGroup ;
  sh:property [
    sh:path dprod:effectiveDate ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime
  ] ;
  sh:property [
    sh:path dprod:expirationDate ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime
  ] ;
.

dprod-shapes:DataContractShape
  a sh:NodeShape ;
  rdfs:isDefinedBy dprod-shapes: ;
  rdfs:label "data contract shape" ;
  sh:targetClass dprod:DataContract ;
  sh:name "Data Contract Shape" ;
  sh:property dprod-shapes:ProfilePropertyGroup ;
  sh:node dprod-shapes:NonEmptyClausesConstraint ;
  sh:property [
    sh:path odrl:assigner ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "DataContract must have exactly one assigner (data provider)."
  ] ;
  sh:property [
    sh:path odrl:assignee ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "DataContract must have exactly one assignee (data consumer)."
  ] ;
  sh:property [
    sh:path dprod:acceptsOffer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class dprod:DataOffer ;
    sh:message "DataContract must reference exactly one DataOffer."
  ] ;
  sh:property dprod-shapes:StatePropertyGroup ;
  sh:property [
    sh:path dprod:effectiveDate ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime
  ] ;
  sh:property [
    sh:path dprod:expirationDate ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime
  ] ;
.


############################# Operand Shapes #########################


dprod-shapes:LeftOperandShape
  a sh:NodeShape ;
  rdfs:isDefinedBy dprod-shapes: ;
  rdfs:label "left operand shape" ;
  sh:targetClass odrl:LeftOperand ;
  sh:name "Left Operand Shape" ;
  sh:property [
    sh:path dprod:path ;
    sh:maxCount 1 ;
    sh:message "LeftOperand may have at most one dprod:path."
  ] ;
  sh:property [
    sh:path dprod:select ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "LeftOperand may have at most one dprod:select."
  ] ;
.


############################# Rejection Shapes #########################
# Reject unsupported ODRL constructs


dprod-shapes:RejectXoneShape
  a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
      SELECT ?this WHERE { ?this odrl:xone ?list . }
    """
  ] ;
  sh:property [
    sh:path odrl:xone ;
    sh:maxCount 0 ;
    sh:severity sh:Violation ;
    sh:message "DPROD contracts do not support xone operator."
  ] ;
.

dprod-shapes:RejectRemedyShape
  a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
      SELECT ?this WHERE { ?this odrl:remedy ?r . }
    """
  ] ;
  sh:property [
    sh:path odrl:remedy ;
    sh:maxCount 0 ;
    sh:severity sh:Violation ;
    sh:message "DPROD contracts do not support odrl:remedy."
  ] ;
.

dprod-shapes:RejectConsequenceShape
  a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
      SELECT ?this WHERE { ?this odrl:consequence ?c . }
    """
  ] ;
  sh:property [
    sh:path odrl:consequence ;
    sh:maxCount 0 ;
    sh:severity sh:Violation ;
    sh:message "DPROD contracts do not support odrl:consequence."
  ] ;
.

dprod-shapes:RejectTicketShape
  a sh:NodeShape ;
  sh:targetClass odrl:Ticket ;
  sh:property [
    sh:path rdf:type ;
    sh:maxCount 0 ;
    sh:severity sh:Violation ;
    sh:message "DPROD contracts do not support odrl:Ticket."
  ] ;
.

dprod-shapes:RejectRequestShape
  a sh:NodeShape ;
  sh:targetClass odrl:Request ;
  sh:property [
    sh:path rdf:type ;
    sh:maxCount 0 ;
    sh:severity sh:Violation ;
    sh:message "DPROD contracts do not support odrl:Request."
  ] ;
.

dprod-shapes:RejectAssetCollectionShape
  a sh:NodeShape ;
  sh:targetClass odrl:AssetCollection ;
  sh:property [
    sh:path rdf:type ;
    sh:maxCount 0 ;
    sh:severity sh:Violation ;
    sh:message "DPROD contracts do not support odrl:AssetCollection. Use dprod:partOf hierarchy instead."
  ] ;
.

dprod-shapes:RejectPartyCollectionShape
  a sh:NodeShape ;
  sh:targetClass odrl:PartyCollection ;
  sh:property [
    sh:path rdf:type ;
    sh:maxCount 0 ;
    sh:severity sh:Violation ;
    sh:message "DPROD contracts do not support odrl:PartyCollection. Use dprod:memberOf hierarchy instead."
  ] ;
.

dprod-shapes:RejectInheritAllowedShape
  a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
      SELECT ?this WHERE { ?this odrl:inheritAllowed ?v . }
    """
  ] ;
  sh:property [
    sh:path odrl:inheritAllowed ;
    sh:maxCount 0 ;
    sh:severity sh:Violation ;
    sh:message "DPROD contracts do not support odrl:inheritAllowed."
  ] ;
.

dprod-shapes:RejectInheritFromShape
  a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
      SELECT ?this WHERE { ?this odrl:inheritFrom ?p . }
    """
  ] ;
  sh:property [
    sh:path odrl:inheritFrom ;
    sh:maxCount 0 ;
    sh:severity sh:Violation ;
    sh:message "DPROD contracts do not support odrl:inheritFrom."
  ] ;
.
