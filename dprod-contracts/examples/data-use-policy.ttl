# =============================================================================
# Example: Internal Data Access Policy
# =============================================================================
# Shows role-based access with purpose constraints and consent tracking,
# using ODRL terms for all standard constructs.
# Target inheritance: policy-level odrl:target is inherited by rules unless
# overridden at rule level.
# =============================================================================

@prefix odrl:     <http://www.w3.org/ns/odrl/2/> .
@prefix dprod:    <https://www.omg.org/spec/DPROD/dprod/> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:       <https://example.org/> .


############################# Inline Domain Vocabulary #########################
# Only the operands, actions, and concept values used in this file.

ex:scheme
  a skos:ConceptScheme ;
  rdfs:label "DPROD vocabulary" ;
  dct:description "Concept scheme for the DPROD vocabulary."@en ;
.

# --- Purpose operand ---
odrl:purpose
  dprod:path odrl:purpose ;
.

# --- Actions ---
ex:log
  a odrl:Action, skos:Concept ;
  rdfs:isDefinedBy ex: ;
  rdfs:label "log" ;
  dct:description "Log access to the asset."@en ;
  odrl:includedIn odrl:inform ;
.

# --- Operands ---
ex:classification
  a odrl:LeftOperand, skos:Concept ;
  rdfs:isDefinedBy ex: ;
  rdfs:label "classification" ;
  dct:description "Data classification level."@en ;
  dprod:path (odrl:target ex:classification) ;
.

ex:processingMode
  a odrl:LeftOperand, skos:Concept ;
  rdfs:isDefinedBy ex: ;
  rdfs:label "processing mode" ;
  dct:description "How data is processed."@en ;
  dprod:path ex:processingMode ;
.

ex:environment
  a odrl:LeftOperand, skos:Concept ;
  rdfs:isDefinedBy ex: ;
  rdfs:label "environment" ;
  dct:description "Execution environment."@en ;
  dprod:path ex:environment ;
.

ex:legalBasis
  a odrl:LeftOperand, skos:Concept ;
  rdfs:isDefinedBy ex: ;
  rdfs:label "legal basis" ;
  dct:description "Legal basis for processing."@en ;
  dprod:path ex:legalBasis ;
.

ex:retentionPeriod
  a odrl:LeftOperand, skos:Concept ;
  rdfs:isDefinedBy ex: ;
  rdfs:label "retention period" ;
  dct:description "Maximum time data may be retained."@en ;
  dprod:path (odrl:target ex:retentionPeriod) ;
.

# --- Concept values ---
ex:analytics
  a skos:Concept ;
  skos:inScheme ex:scheme ;
  rdfs:label "analytics" ;
  dct:description "General analytical use."@en ;
.

ex:compliance
  a skos:Concept ;
  skos:inScheme ex:scheme ;
  rdfs:label "compliance" ;
  dct:description "Regulatory compliance."@en ;
.

ex:confidential
  a skos:Concept ;
  skos:inScheme ex:scheme ;
  rdfs:label "confidential" ;
.

ex:modelTraining
  a skos:Concept ;
  skos:inScheme ex:scheme ;
  rdfs:label "model training" ;
.

ex:production
  a skos:Concept ;
  skos:inScheme ex:scheme ;
  rdfs:label "production" ;
.

ex:staging
  a skos:Concept ;
  skos:inScheme ex:scheme ;
  rdfs:label "staging" ;
.

ex:operations
  a skos:Concept ;
  skos:inScheme ex:scheme ;
  rdfs:label "operations" ;
  dct:description "Operational use."@en ;
.

ex:legitimateInterest
  a skos:Concept ;
  skos:inScheme ex:scheme ;
  rdfs:label "legitimate interest" ;
.


############################# Parties (Hierarchy) #########################

<https://example.org/agents/hr-analytics> a odrl:Party ;
    rdfs:label "HR Analytics Team" ;
    odrl:partOf <https://example.org/agents/hr-division> .

<https://example.org/agents/hr-division> a odrl:PartyCollection ;
    rdfs:label "Human Resources Division" .

<https://example.org/agents/compliance-team> a odrl:Party ;
    rdfs:label "Compliance Team" .


############################# Assets (Hierarchy) #########################

<https://example.org/assets/employee-compensation> a odrl:Asset ;
    rdfs:label "Employee Compensation Data" ;
    odrl:partOf <https://example.org/assets/employee-data> .

<https://example.org/assets/employee-performance> a odrl:Asset ;
    rdfs:label "Employee Performance Reviews" ;
    odrl:partOf <https://example.org/assets/employee-data> .

<https://example.org/assets/employee-data> a odrl:AssetCollection ;
    rdfs:label "Employee Data Lake" .

<https://example.org/assets/access-log> a odrl:Asset ;
    rdfs:label "Access Log" .


############################# Policy Set: HR Data Access Controls #########################
# This is a Set (no parties) — applies to anyone matching the conditions.
# Target inheritance: rules inherit employee-data target unless overridden.

<https://example.org/policies/hr-data-access> a odrl:Set ;
    rdfs:label "HR Data Access Policy" ;
    odrl:profile <https://www.omg.org/spec/DPROD/> ;
    odrl:target <https://example.org/assets/employee-data> ;

    # ===== RULE 1: HR Analytics can read for analytics purposes =====
    odrl:permission [
        a odrl:Permission ;
        rdfs:label "HR analytics read access" ;
        odrl:assignee <https://example.org/agents/hr-analytics> ;
        odrl:action odrl:read ;
        odrl:constraint [
            a odrl:Constraint ;
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand ex:analytics
        ]
    ] ;

    # ===== RULE 2: Compliance can read for compliance purposes =====
    odrl:permission [
        a odrl:Permission ;
        rdfs:label "Compliance audit access" ;
        odrl:assignee <https://example.org/agents/compliance-team> ;
        odrl:action odrl:read ;
        odrl:constraint [
            a odrl:Constraint ;
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand ex:compliance
        ]
    ] ;

    # ===== RULE 3: Anyone reading must log access =====
    # Target differs from policy — access-log, not employee-data
    odrl:obligation [
        a odrl:Duty ;
        rdfs:label "Mandatory audit logging" ;
        odrl:action ex:log ;
        odrl:target <https://example.org/assets/access-log> ;
        odrl:constraint [
            a odrl:Constraint ;
            odrl:leftOperand ex:classification ;
            odrl:operator odrl:eq ;
            odrl:rightOperand ex:confidential
        ] ;
        dprod:deadline "PT1H"^^xsd:duration
    ] ;

    # ===== RULE 4: No external distribution =====
    odrl:prohibition [
        a odrl:Prohibition ;
        rdfs:label "No external sharing" ;
        odrl:action odrl:distribute
    ] ;

    # ===== RULE 5: No use for model training =====
    odrl:prohibition [
        a odrl:Prohibition ;
        rdfs:label "No ML training" ;
        odrl:action odrl:use ;
        odrl:constraint [
            a odrl:Constraint ;
            odrl:leftOperand ex:processingMode ;
            odrl:operator odrl:eq ;
            odrl:rightOperand ex:modelTraining
        ]
    ] ;

    # ===== RULE 6: Production only =====
    odrl:prohibition [
        a odrl:Prohibition ;
        rdfs:label "Production and staging only" ;
        odrl:action odrl:use ;
        odrl:constraint [
            a odrl:Constraint ;
            odrl:leftOperand ex:environment ;
            odrl:operator odrl:isNoneOf ;
            odrl:rightOperand (ex:production ex:staging)
        ]
    ] .


############################# Policy Set: Compensation Data (Stricter) #########################
# More restrictive policy for sensitive compensation data.
# Target inheritance: rules inherit employee-compensation target.

<https://example.org/policies/compensation-access> a odrl:Set ;
    rdfs:label "Compensation Data Access Policy" ;
    odrl:profile <https://www.omg.org/spec/DPROD/> ;
    odrl:target <https://example.org/assets/employee-compensation> ;

    # Only HR Division (not just analytics sub-team)
    odrl:permission [
        a odrl:Permission ;
        rdfs:label "HR Division compensation access" ;
        odrl:assignee <https://example.org/agents/hr-division> ;
        odrl:action odrl:read ;
        odrl:constraint [
            a odrl:LogicalConstraint ;
            odrl:and (
                [
                    a odrl:Constraint ;
                    odrl:leftOperand odrl:purpose ;
                    odrl:operator odrl:isAnyOf ;
                    odrl:rightOperand (ex:compliance ex:operations)
                ]
                [
                    a odrl:Constraint ;
                    odrl:leftOperand ex:legalBasis ;
                    odrl:operator odrl:eq ;
                    odrl:rightOperand ex:legitimateInterest
                ]
            )
        ]
    ] ;

    # Retention limit: delete after 7 years
    odrl:obligation [
        a odrl:Duty ;
        rdfs:label "Retention limit" ;
        odrl:action odrl:delete ;
        odrl:constraint [
            a odrl:Constraint ;
            odrl:leftOperand ex:retentionPeriod ;
            odrl:operator odrl:gt ;
            odrl:rightOperand "P7Y"^^xsd:duration
        ]
    ] ;

    # Mandatory anonymization for any analytics
    odrl:obligation [
        a odrl:Duty ;
        rdfs:label "Anonymization required" ;
        odrl:action odrl:anonymize ;
        odrl:constraint [
            a odrl:Constraint ;
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand ex:analytics
        ]
    ] .
