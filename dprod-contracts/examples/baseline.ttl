<https://example.org/duties/mkt-delivery-2026-001> a odrl:Duty ;
    rdfs:label "Market data delivery (latest interval)" ;
    dprod:subjectOfDuty <https://example.org/agents/trading-data> ;
    dprod:objectOfDuty <https://example.org/agents/analytics> ;
    odrl:action ex:deliver ;
    odrl:target <https://example.org/assets/market-prices> ;
    dprod:recurrence "FREQ=MINUTELY;INTERVAL=15" ;
