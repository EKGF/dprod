############################# Duty Instances (with lifecycle state) #########################

<https://example.org/duties/cust-delivery-2026-001> a odrl:Duty ;
    rdfs:label "Customer data delivery (2026-02-04)" ;
    dprod:subject <https://example.org/agents/data-platform> ;
    dprod:object <https://example.org/agents/analytics> ;
    odrl:action dprod-due:deliver ;
    odrl:target <https://example.org/assets/customer-data> ;
    dprod:recurrence "FREQ=DAILY;BYHOUR=7;BYMINUTE=0" ;
    dprod:deadline "PT30M"^^xsd:duration ;
    dprod:state dprod:Fulfilled .

<https://example.org/duties/cust-schema-2026-001> a odrl:Duty ;
    rdfs:label "Customer API schema conformance" ;
    dprod:subject <https://example.org/agents/data-platform> ;
    dprod:object <https://example.org/agents/analytics> ;
    odrl:action dprod-due:conformTo ;
    odrl:target <https://example.org/assets/customer-api-schema> ;
    dprod:state dprod:Active .

<https://example.org/duties/cust-report-2026-001> a odrl:Duty ;
    rdfs:label "Analytics usage report (February)" ;
    dprod:subject <https://example.org/agents/analytics> ;
    dprod:object <https://example.org/agents/data-platform> ;
    odrl:action dprod-due:report ;
    odrl:target <https://example.org/assets/usage-stats> ;
    dprod:deadline "P30D"^^xsd:duration ;
    dprod:state dprod:Active .

<https://example.org/duties/mkt-delivery-2026-001> a odrl:Duty ;
    rdfs:label "Market data delivery (latest interval)" ;
    dprod:subject <https://example.org/agents/trading-data> ;
    dprod:object <https://example.org/agents/analytics> ;
    odrl:action dprod-due:deliver ;
    odrl:target <https://example.org/assets/market-prices> ;
    dprod:recurrence "FREQ=MINUTELY;INTERVAL=15" ;
    dprod:deadline "PT5M"^^xsd:duration ;
    dprod:state dprod:Fulfilled .

<https://example.org/duties/mkt-schema-2026-001> a odrl:Duty ;
    rdfs:label "Market data schema conformance" ;
    dprod:subject <https://example.org/agents/trading-data> ;
    dprod:object <https://example.org/agents/analytics> ;
    odrl:action dprod-due:conformTo ;
    odrl:target <https://example.org/assets/market-data-schema> ;
    dprod:state dprod:Active .

<https://example.org/duties/mkt-delivery-2026-late> a odrl:Duty ;
    rdfs:label "Market data delivery (missed interval)" ;
    dprod:subject <https://example.org/agents/trading-data> ;
    odrl:action dprod-due:deliver ;
    odrl:target <https://example.org/assets/market-prices> ;
    dprod:recurrence "FREQ=MINUTELY;INTERVAL=15" ;
    dprod:deadline "PT5M"^^xsd:duration ;
    dprod:state dprod:Violated .
