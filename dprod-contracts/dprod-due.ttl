############################# DUE-Specific Actions #########################
# ODRL Common Vocabulary actions (odrl:use, odrl:read, odrl:display,
# odrl:distribute, odrl:delete, odrl:modify, odrl:aggregate,
# odrl:anonymize, odrl:derive) are used directly.

dprod-due:nonDisplay
  a odrl:Action, skos:Concept ;
  rdfs:isDefinedBy dprod-due: ;
  rdfs:label "non-display" ;
  dct:description "Use data for automated/programmatic purposes."@en ;
  odrl:includedIn odrl:use ;
  rdfs:comment "Algorithmic use: models, automation, calculations."@en ;
.

dprod-due:conformTo
  a odrl:Action, skos:Concept ;
  rdfs:isDefinedBy dprod-due: ;
  rdfs:label "conform to" ;
  dct:description "Conform to a schema or specification."@en ;
  rdfs:comment
    """Provider governance duty: ensure data conforms to published schema.
    The duty target (odrl:target) is the schema/specification.
    conformTo is the operational counterpart to dct:conformsTo: an ongoing
    obligation to maintain conformance. No odrl:includedIn — conformTo is
    a duty-only action (schema/quality SLA)."""@en ;
  rdfs:seeAlso dct:conformsTo ;
.

dprod-due:log
  a odrl:Action, skos:Concept ;
  rdfs:isDefinedBy dprod-due: ;
  rdfs:label "log" ;
  dct:description "Log access to the asset."@en ;
  odrl:includedIn odrl:inform ;
.

dprod-due:notify
  a odrl:Action, skos:Concept ;
  rdfs:isDefinedBy dprod-due: ;
  rdfs:label "notify" ;
  dct:description "Notify relevant parties."@en ;
  odrl:includedIn odrl:inform ;
.

dprod-due:report
  a odrl:Action, skos:Concept ;
  rdfs:isDefinedBy dprod-due: ;
  rdfs:label "report" ;
  dct:description "Submit usage reports."@en ;
  odrl:includedIn odrl:inform ;
  rdfs:comment "Typically an assignee duty: report usage to data owner."@en ;
.

dprod-due:deliver
  a odrl:Action, skos:Concept ;
  rdfs:isDefinedBy dprod-due: ;
  rdfs:label "deliver" ;
  dct:description "Deliver data to consumer."@en ;
  odrl:includedIn odrl:distribute ;
  rdfs:comment "Typically an assigner duty in data contracts."@en ;
.


