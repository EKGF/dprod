# Environment for the DPROD marketing/spec site (site/).
#
# All four are read at request time by src/lib/spec-versions.ts. Set them on
# the Vercel project (Settings -> Environment Variables), not in the repo.

# --- Vercel API: which branches have a READY deployment ---------------------
# A Vercel access token with read access to the dprod project.
VERCEL_TOKEN=
# Both are also injected automatically by Vercel at build time, but the
# spec-versions lookup runs per-request, so they must exist as real
# environment variables too.
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=

# --- GitHub API: which of those branches still exist ------------------------
# REQUIRED. Without it the branch lookup runs unauthenticated, where GitHub
# allows 60 requests/hour per IP shared across all of Vercel's egress. That is
# exhausted continuously, so the lookup fails and the version picker degrades
# to showing only the archive and develop.
#
# A fine-grained token needs only: Repository access -> EKGF/dprod,
# Repository permissions -> Metadata: Read-only. No write scopes.
# A classic token needs `public_repo` (or `repo` for private forks).
GITHUB_TOKEN=
