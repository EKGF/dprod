    "@graph": [
        {
            "@id": "dprod-shapes:DataService-protocol",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "A protocol (possibly one of many options) used to communicate with this data service."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data service protocol shape",
            "sh:class": {
                "@id": "dcat:Protocol"
            },
            "sh:path": {
                "@id": "dprod:protocol"
            }
        },
        {
            "@id": "dprod-shapes:DataProductLifecycleStatusShape",
            "@type": "sh:NodeShape",
            "dct:description": {
                "@language": "en",
                "@value": "The development status of the data product taken from a controlled list (e.g. Ideation, Design, Build, Deploy, Consume)."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data product lifecycle status shape",
            "sh:targetClass": {
                "@id": "dprod:DataProductLifecycleStatus"
            }
        },
        {
            "@id": "dprod-shapes:DataProduct-hasPolicy",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "An ODRL conformant policy expressing the rights associated with the data product. This is an inferred relationship based on the rights expressed on the individual datasets of the data product."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data product has policy shape",
            "sh:class": {
                "@id": "odrl:Policy"
            },
            "sh:path": {
                "@id": "odrl:hasPolicy"
            }
        },
        {
            "@id": "dprod-shapes:Distribution-isDistributionOf",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "The dataset that this distribution makes available."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "distribution is distribution of shape",
            "sh:class": {
                "@id": "dcat:Dataset"
            },
            "sh:path": {
                "@id": "dprod:isDistributionOf"
            }
        },
        {
            "@id": "dprod-shapes:Dataset-label",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "The name given to the dataset"
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "dataset label shape",
            "sh:datatype": {
                "@id": "xsd:string"
            },
            "sh:path": {
                "@id": "rdfs:label"
            }
        },
        {
            "@id": "dprod-shapes:DataService-endpointURL",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "The root location or primary endpoint of the service."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data service endpoint URL shape",
            "sh:path": {
                "@id": "dcat:endpointURL"
            }
        },
        {
            "@id": "dcat:Dataset-informationSensitivityClassification",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "More granular classification that indicates the level of control and protection that must be applied to the asset due to the nature of the data and its sensitivity or importance to the organization."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "dataset information sensitivity classification shape",
            "sh:class": {
                "@id": "dprod:InformationSensitivityClassification"
            },
            "sh:path": {
                "@id": "dprod:informationSensitivityClassification"
            }
        },
        {
            "@id": "dprod-shapes:InformationSensitivityClassificationShape",
            "@type": "sh:NodeShape",
            "dct:description": {
                "@language": "en",
                "@value": "A classification of the information within a dataset to indicate the level of control and protection that must be applied."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "information sensitivity classification shape",
            "sh:targetClass": {
                "@id": "dprod:InformationSensitivityClassification"
            }
        },
        {
            "@id": "dprod-shapes:ProtocolShape",
            "@type": "sh:NodeShape",
            "dct:description": {
                "@language": "en",
                "@value": "A detailed specification, possibly including a specific version, for how to communicate with a service."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "protocol shape",
            "sh:targetClass": {
                "@id": "dprod:Protocol"
            }
        },
