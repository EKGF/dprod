        {
            "@id": "dprod-shapes:Dataset-conformsTo",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "A model, schema, ontology, view or profile that the dataset conforms to."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "dataset conforms to shape",
            "sh:path": {
                "@id": "dct:conformsTo"
            }
        },
        {
            "@id": "dprod-shapes:DataProduct-purpose",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "A description of the objectives and intended usage of the data product."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data product purpose shape",
            "sh:datatype": {
                "@id": "xsd:string"
            },
            "sh:path": {
                "@id": "dprod:purpose"
            }
        },
        {
            "@id": "dprod-shapes:Distribution-conformsTo",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "The schema that the distribution conforms to that is format and technology dependent."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "distribution conforms to shape",
            "sh:path": {
                "@id": "dct:conformsTo"
            }
        },
        {
            "@id": "dprod-shapes:Distribution-format",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "The file format of the distribution."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "distribution format shape",
            "sh:path": {
                "@id": "dct:format"
            }
        },
        {
            "@id": "dprod-shapes:DistributionShape",
            "@type": "sh:NodeShape",
            "dct:description": {
                "@language": "en",
                "@value": "A specific representation of a dataset. A dataset might be available in multiple serializations that may differ in various ways, including natural language, media-type or format, schematic organization, temporal and spatial resolution, level of detail or profiles (which might specify any or all of the above)."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "distribution shape",
            "sh:property": [
                {
                    "@id": "dprod-shapes:Distribution-accessService"
                },
                {
                    "@id": "dprod-shapes:Distribution-conformsTo"
                },
                {
                    "@id": "dprod-shapes:Distribution-isDistributionOf"
                },
                {
                    "@id": "dprod-shapes:Distribution-format"
                }
            ],
            "sh:targetClass": {
                "@id": "dcat:Distribution"
            }
        },
        {
            "@id": "dprod-shapes:DataServiceShape",
            "@type": "sh:NodeShape",
            "dct:description": {
                "@language": "en",
                "@value": "A collection of operations that provides access to one or more datasets or data processing functions."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data service shape",
            "sh:property": [
                {
                    "@id": "dprod-shapes:DataService-isAccessServiceOf"
                },
                {
                    "@id": "dprod-shapes:DataService-protocol"
                },
                {
                    "@id": "dprod-shapes:DataService-securitySchemaType"
                },
                {
                    "@id": "dprod-shapes:DataService-endpointURL"
                },
                {
                    "@id": "dprod-shapes:DataService-endpointDescription"
                }
            ],
            "sh:targetClass": {
                "@id": "dcat:DataService"
            }
        },
        {
            "@id": "dprod-shapes:DataProduct-dataProductOwner",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "The agent that is accountable overall for the data product, including managing it through its lifecycle."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data product owner shape",
            "sh:class": {
                "@id": "prov:Agent"
            },
            "sh:path": {
                "@id": "dprod:dataProductOwner"
            }
        },
        {
            "@id": "dprod-shapes:DataProduct-label",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "The name given to the data product."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data product label shape",
            "sh:datatype": {
                "@id": "xsd:string"
            },
            "sh:path": {
                "@id": "rdfs:label"
            }
        },
        {
            "@id": "dprod-shapes:DatasetShape",
            "@type": "sh:NodeShape",
            "dct:description": {
                "@language": "en",
                "@value": "A collection of data, published or curated by a single source, and available for access or download in one or more representations."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "dataset shape",
            "sh:property": [
                {
                    "@id": "dprod-shapes:Dataset-label"
                },
                {
                    "@id": "dprod-shapes:Dataset-description"
                },
                {
                    "@id": "dprod-shapes:Dataset-type"
                },
                {
                    "@id": "dprod-shapes:Dataset-distribution"
                },
                {
                    "@id": "dprod-shapes:Dataset-conformsTo"
                },
                {
                    "@id": "dprod-shapes:Dataset-hasPolicy"
                },
                {
                    "@id": "dcat:Dataset-informationSensitivityClassification"
                }
            ],
            "sh:targetClass": {
                "@id": "dcat:Dataset"
            }
        },
        {
            "@id": "dprod-shapes:Distribution-accessService",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "A data service that gives access to the distribution of the dataset."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "distribution access service shape",
            "sh:class": {
                "@id": "dcat:DataService"
            },
            "sh:path": {
                "@id": "dcat:accessService"
            }
        },
        {
            "@id": "dprod-shapes:DataProduct-lifecycleStatus",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "The development status of the data product. "
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data product lifecycle status shape",
            "sh:class": {
                "@id": "dprod:DataProductLifecycleStatus"
            },
            "sh:path": {
                "@id": "dprod:lifecycleStatus"
            }
        },
        {
            "@id": "dprod-shapes:Dataset-description",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "Free text description of the dataset."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "dataset distribution shape",
            "sh:datatype": {
                "@id": "xsd:string"
            },
            "sh:path": {
                "@id": "dct:description"
            }
        },
        {
            "@id": "dprod-shapes:DataProduct-inputDataset",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "The source data made available to the data product through input data services. Depending on the lifecycle of the data product, this may be a stated or inferred relationship aligned with the input ports."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data product input dataset shape",
            "sh:class": {
                "@id": "dcat:Dataset"
            },
            "sh:path": {
                "@id": "dprod:inputDataset"
            }
        },
        {
            "@id": "dprod-shapes:SecuritySchemaTypeShape",
            "@type": "sh:NodeShape",
            "dct:description": {
                "@language": "en",
                "@value": "A classification encompassing a set of rules used for authentication and communication."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "security schema type shape",
            "sh:targetClass": {
                "@id": "dprod:SecuritySchemaType"
            }
        },
        {
            "@id": "dprod-shapes:DataService-isAccessServiceOf",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "The dataset distribution that is being offered through this data service."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data service is access service of shape",
            "sh:class": {
                "@id": "dcat:Distribution"
            },
            "sh:path": {
                "@id": "dprod:isAccessServiceOf"
            }
        },
        {
            "@id": "dprod-shapes:Dataset-hasPolicy",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "An ODRL conformant policy expressing the rights associated with the resource."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "dataset has policy shape",
            "sh:path": {
                "@id": "odrl:hasPolicy"
            }
        },
        {
            "@id": "dprod-shapes:DataProduct-description",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "A free text description of the data product."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data product description shape",
            "sh:datatype": {
                "@id": "xsd:string"
            },
            "sh:path": {
                "@id": "dct:description"
            }
        },
        {
            "@id": "dprod-shapes:Dataset-type",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "The type or genre of the dataset."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "dataset type shape",
            "sh:path": {
                "@id": "dct:type"
            }
        },
        {
            "@id": "dprod-shapes:DataProduct-outputPort",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "A set of services exposed by a data product to share the generated data in a way that can be understood and trusted."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data product output port shape",
            "sh:class": {
                "@id": "dcat:DataService"
            },
            "sh:path": {
                "@id": "dprod:outputPort"
            }
        },
        {
            "@id": "dprod-shapes:DataProductShape",
            "@type": "sh:NodeShape",
            "dct:description": {
                "@language": "en",
                "@value": "A rational, managed, and governed collection of data, with purpose, value and ownership, meeting consumer needs over a planned life-cycle."
            },
            "rdfs:comment": {
                "@language": "en",
                "@value": "A data product may have input and output ports, code and metadata"
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data product shape",
            "sh:property": [
                {
                    "@id": "dprod-shapes:DataProduct-label"
                },
                {
                    "@id": "dprod-shapes:DataProduct-description"
                },
                {
                    "@id": "dprod-shapes:DataProduct-dataProductOwner"
                },
                {
                    "@id": "dprod-shapes:DataProduct-domain"
                },
                {
                    "@id": "dprod-shapes:DataProduct-inputPort"
                },
                {
                    "@id": "dprod-shapes:DataProduct-outputPort"
                },
                {
                    "@id": "dprod-shapes:DataProduct-inputDataset"
                },
                {
                    "@id": "dprod-shapes:DataProduct-outputDataset"
                },
                {
                    "@id": "dprod-shapes:DataProduct-purpose"
                },
                {
                    "@id": "dprod-shapes:DataProduct-hasPolicy"
                },
                {
                    "@id": "dprod-shapes:DataProduct-lifecycleStatus"
                }
            ],
            "sh:targetClass": {
                "@id": "dprod:DataProduct"
            }
        },
        {
            "@id": "dprod-shapes:DataProduct-domain",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "The business or information area supported by the data product."
            },
            "rdfs:comment": {
                "@language": "en",
                "@value": "The target class is left open"
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data product domain shape",
            "sh:path": {
                "@id": "dprod:domain"
            }
        },
        {
            "@id": "dprod-shapes:Dataset-distribution",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "An available distribution of the dataset."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "dataset distribution shape",
            "sh:class": {
                "@id": "dcat:Distribution"
            },
            "sh:path": {
                "@id": "dcat:distribution"
            }
        },
        {
            "@id": "dprod-shapes:DataProduct-outputDataset",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "The data that is exposed by the data product through output data services in a way that can be understood and trusted. Depending on the lifecycle of the data product, this may be a stated or inferred relationship aligned with the output ports."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data product output dataset shape",
            "sh:class": {
                "@id": "dcat:Dataset"
            },
            "sh:path": {
                "@id": "dprod:outputDataset"
            }
        },
        {
            "@id": "dprod-shapes:DataService-endpointDescription",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "A description of the services available via the end-points, including their operations, parameters etc."
            },
            "rdfs:isDefinedBy": {
                "@id": "dprod-shapes:"
            },
            "rdfs:label": "data service endpoint description shape",
            "sh:path": {
                "@id": "dcat:endpointDescription"
            }
        },
        {
            "@id": "dprod-shapes:DataProduct-inputPort",
            "@type": "sh:PropertyShape",
            "dct:description": {
                "@language": "en",
                "@value": "A set of services exposed by a data product to collect its source data and makes it available for further internal transformation. An input port can receive data from one or more upstream sources in a push (i.e. asynchronous subscription) or pop mode (i.e. synchronous query). Each data product may have one or more input ports."
            },
            "rdfs:isDefinedBy": {
