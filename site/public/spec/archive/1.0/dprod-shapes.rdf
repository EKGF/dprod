<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xml:base="https://ekgf.github.io/dprod/shapes/"
  xmlns:sh="http://www.w3.org/ns/shacl#"
  xmlns:dct="http://purl.org/dc/terms/"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <sh:NodeShape rdf:about="InformationSensitivityClassificationShape">
    <rdfs:label>information sensitivity classification shape</rdfs:label>
    <dct:description xml:lang="en">A classification of the information within a dataset to indicate the level of control and protection that must be applied.</dct:description>
    <rdfs:isDefinedBy>
      <owl:Ontology rdf:about="">
        <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dct:title xml:lang="en">Shapes for the Data Product (DPROD) Ontology</dct:title>
        <rdfs:label xml:lang="en">DPROD ontology shapes</rdfs:label>
        <dct:description xml:lang="en">SHACL shapes for DPROD, including the DCAT classes and properties to be used.</dct:description>
        <rdfs:comment xml:lang="en">This is intended to be used with SHACL, not as an ontology: the ontology element is to provide the metadata for the set of shapes.</rdfs:comment>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-08-31</dct:modified>
        <dct:contributor rdf:resource="https://www.linkedin.com/in/natasavaritimou"/>
        <dct:contributor rdf:resource="https://www.linkedin.com/in/peterivett"/>
        <dct:contributor rdf:resource="https://www.linkedin.com/in/jgeluk"/>
        <dct:contributor rdf:resource="https://www.linkedin.com/in/marcel-fr%C3%B6hlich-648a043"/>
        <dct:contributor rdf:resource="https://www.linkedin.com/in/matthias-jurisch"/>
        <dct:contributor rdf:resource="https://www.linkedin.com/in/tonyseale"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/dcat#"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/shacl#"/>
        <owl:imports rdf:resource="https://ekgf.github.io/dprod/"/>
        <owl:versionInfo>OMG Request For Comments Errata 2</owl:versionInfo>
        <sh:declare>
          <rdf:Description rdf:nodeID="n1808fdfa142d49ab87b594308213bcf0b1">
            <sh:prefix>dprod</sh:prefix>
            <sh:namespace>https://ekgf.github.io/dprod/</sh:namespace>
          </rdf:Description>
        </sh:declare>
        <sh:declare>
          <rdf:Description rdf:nodeID="n1808fdfa142d49ab87b594308213bcf0b2">
            <sh:prefix>dprod-shapes</sh:prefix>
            <sh:namespace>https://ekgf.github.io/dprod/shapes/</sh:namespace>
          </rdf:Description>
        </sh:declare>
        <sh:declare>
          <rdf:Description rdf:nodeID="n1808fdfa142d49ab87b594308213bcf0b3">
            <sh:prefix>dcat</sh:prefix>
            <sh:namespace>http://www.w3.org/ns/dcat#</sh:namespace>
          </rdf:Description>
        </sh:declare>
      </owl:Ontology>
    </rdfs:isDefinedBy>
    <sh:targetClass rdf:resource="https://ekgf.github.io/dprod/InformationSensitivityClassification"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="DataProductShape">
    <dct:description xml:lang="en">A rational, managed, and governed collection of data, with purpose, value and ownership, meeting consumer needs over a planned life-cycle.</dct:description>
    <rdfs:comment xml:lang="en">A data product may have input and output ports, code and metadata</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label>data product shape</rdfs:label>
    <sh:targetClass rdf:resource="https://ekgf.github.io/dprod/DataProduct"/>
    <sh:property>
      <sh:PropertyShape rdf:about="DataProduct-label">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dct:description xml:lang="en">The name given to the data product.</dct:description>
        <rdfs:label>data product label shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="DataProduct-description">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="http://purl.org/dc/terms/description"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dct:description xml:lang="en">A free text description of the data product.</dct:description>
        <rdfs:label>data product description shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="DataProduct-dataProductOwner">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="https://ekgf.github.io/dprod/dataProductOwner"/>
        <sh:class rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <dct:description xml:lang="en">The agent that is accountable overall for the data product, including managing it through its lifecycle.</dct:description>
        <rdfs:label>data product owner shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="DataProduct-domain">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="https://ekgf.github.io/dprod/domain"/>
        <dct:description xml:lang="en">The business or information area supported by the data product.</dct:description>
        <rdfs:comment xml:lang="en">The target class is left open</rdfs:comment>
        <rdfs:label>data product domain shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="DataProduct-inputPort">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="https://ekgf.github.io/dprod/inputPort"/>
        <sh:class rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
        <dct:description xml:lang="en">A set of services exposed by a data product to collect its source data and makes it available for further internal transformation. An input port can receive data from one or more upstream sources in a push (i.e. asynchronous subscription) or pop mode (i.e. synchronous query). Each data product may have one or more input ports.</dct:description>
        <rdfs:label>data product input port shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="DataProduct-outputPort">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="https://ekgf.github.io/dprod/outputPort"/>
        <sh:class rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
        <dct:description xml:lang="en">A set of services exposed by a data product to share the generated data in a way that can be understood and trusted.</dct:description>
        <rdfs:label>data product output port shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="DataProduct-inputDataset">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="https://ekgf.github.io/dprod/inputDataset"/>
        <sh:class rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <dct:description xml:lang="en">The source data made available to the data product through input data services. Depending on the lifecycle of the data product, this may be a stated or inferred relationship aligned with the input ports.</dct:description>
        <rdfs:label>data product input dataset shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="DataProduct-outputDataset">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="https://ekgf.github.io/dprod/outputDataset"/>
        <sh:class rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <dct:description xml:lang="en">The data that is exposed by the data product through output data services in a way that can be understood and trusted. Depending on the lifecycle of the data product, this may be a stated or inferred relationship aligned with the output ports.</dct:description>
        <rdfs:label>data product output dataset shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="DataProduct-purpose">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="https://ekgf.github.io/dprod/purpose"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dct:description xml:lang="en">A description of the objectives and intended usage of the data product.</dct:description>
        <rdfs:label>data product purpose shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="DataProduct-hasPolicy">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="http://www.w3.org/ns/odrl/2/hasPolicy"/>
        <sh:class rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
        <dct:description xml:lang="en">An ODRL conformant policy expressing the rights associated with the data product. This is an inferred relationship based on the rights expressed on the individual datasets of the data product.</dct:description>
        <rdfs:label>data product has policy shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="DataProduct-lifecycleStatus">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="https://ekgf.github.io/dprod/lifecycleStatus"/>
        <sh:class rdf:resource="https://ekgf.github.io/dprod/DataProductLifecycleStatus"/>
        <dct:description xml:lang="en">The development status of the data product. </dct:description>
        <rdfs:label>data product lifecycle status shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="ProtocolShape">
    <rdfs:label>protocol shape</rdfs:label>
    <dct:description xml:lang="en">A detailed specification, possibly including a specific version, for how to communicate with a service.</dct:description>
    <rdfs:isDefinedBy rdf:resource=""/>
    <sh:targetClass rdf:resource="https://ekgf.github.io/dprod/Protocol"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="DatasetShape">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label>dataset shape</rdfs:label>
    <dct:description xml:lang="en">A collection of data, published or curated by a single source, and available for access or download in one or more representations.</dct:description>
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <sh:property>
      <sh:PropertyShape rdf:about="Dataset-label">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dct:description xml:lang="en">The name given to the dataset</dct:description>
        <rdfs:label>dataset label shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="Dataset-description">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="http://purl.org/dc/terms/description"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dct:description xml:lang="en">Free text description of the dataset.</dct:description>
        <rdfs:label>dataset distribution shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="Dataset-type">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="http://purl.org/dc/terms/type"/>
        <dct:description xml:lang="en">The type or genre of the dataset.</dct:description>
        <rdfs:label>dataset type shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="Dataset-distribution">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="http://www.w3.org/ns/dcat#distribution"/>
        <sh:class rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <dct:description xml:lang="en">An available distribution of the dataset.</dct:description>
        <rdfs:label>dataset distribution shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="Dataset-conformsTo">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="http://purl.org/dc/terms/conformsTo"/>
        <dct:description xml:lang="en">A model, schema, ontology, view or profile that the dataset conforms to.</dct:description>
        <rdfs:label>dataset conforms to shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="Dataset-hasPolicy">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="http://www.w3.org/ns/odrl/2/hasPolicy"/>
        <dct:description xml:lang="en">An ODRL conformant policy expressing the rights associated with the resource.</dct:description>
        <rdfs:label>dataset has policy shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="http://www.w3.org/ns/dcat#Dataset-informationSensitivityClassification">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="https://ekgf.github.io/dprod/informationSensitivityClassification"/>
        <sh:class rdf:resource="https://ekgf.github.io/dprod/InformationSensitivityClassification"/>
        <dct:description xml:lang="en">More granular classification that indicates the level of control and protection that must be applied to the asset due to the nature of the data and its sensitivity or importance to the organization.</dct:description>
        <rdfs:label>dataset information sensitivity classification shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="SecuritySchemaTypeShape">
    <rdfs:label>security schema type shape</rdfs:label>
    <dct:description xml:lang="en">A classification encompassing a set of rules used for authentication and communication.</dct:description>
    <rdfs:isDefinedBy rdf:resource=""/>
    <sh:targetClass rdf:resource="https://ekgf.github.io/dprod/SecuritySchemaType"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="DataServiceShape">
    <rdfs:isDefinedBy rdf:resource=""/>
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
    <rdfs:label>data service shape</rdfs:label>
    <dct:description xml:lang="en">A collection of operations that provides access to one or more datasets or data processing functions.</dct:description>
    <sh:property>
      <sh:PropertyShape rdf:about="DataService-isAccessServiceOf">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="https://ekgf.github.io/dprod/isAccessServiceOf"/>
        <sh:class rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <dct:description xml:lang="en">The dataset distribution that is being offered through this data service.</dct:description>
        <rdfs:label>data service is access service of shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="DataService-protocol">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="https://ekgf.github.io/dprod/protocol"/>
        <sh:class rdf:resource="http://www.w3.org/ns/dcat#Protocol"/>
        <dct:description xml:lang="en">A protocol (possibly one of many options) used to communicate with this data service.</dct:description>
        <rdfs:label>data service protocol shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="DataService-securitySchemaType">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="https://ekgf.github.io/dprod/securitySchemaType"/>
        <sh:class rdf:resource="http://www.w3.org/ns/dcat#SecuritySchemaType"/>
        <dct:description xml:lang="en">The security schema type used for authentication and communication with this Data Service.</dct:description>
        <rdfs:label>data service security schema type shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="DataService-endpointURL">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="http://www.w3.org/ns/dcat#endpointURL"/>
        <dct:description xml:lang="en">The root location or primary endpoint of the service.</dct:description>
        <rdfs:label>data service endpoint URL shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="DataService-endpointDescription">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="http://www.w3.org/ns/dcat#endpointDescription"/>
        <dct:description xml:lang="en">A description of the services available via the end-points, including their operations, parameters etc.</dct:description>
        <rdfs:label>data service endpoint description shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
  </sh:NodeShape>
  <sh:PropertyShape rdf:about="DataProduct-type">
    <rdfs:isDefinedBy rdf:resource=""/>
    <sh:path rdf:resource="http://purl.org/dc/terms/type"/>
    <dct:description xml:lang="en">The nature or genre of the data product.</dct:description>
    <rdfs:label>data product description shape</rdfs:label>
  </sh:PropertyShape>
  <sh:NodeShape rdf:about="DistributionShape">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label>distribution shape</rdfs:label>
    <dct:description xml:lang="en">A specific representation of a dataset. A dataset might be available in multiple serializations that may differ in various ways, including natural language, media-type or format, schematic organization, temporal and spatial resolution, level of detail or profiles (which might specify any or all of the above).</dct:description>
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
    <sh:property>
      <sh:PropertyShape rdf:about="Distribution-accessService">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="http://www.w3.org/ns/dcat#accessService"/>
        <sh:class rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
        <dct:description xml:lang="en">A data service that gives access to the distribution of the dataset.</dct:description>
        <rdfs:label>distribution access service shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="Distribution-conformsTo">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="http://purl.org/dc/terms/conformsTo"/>
        <dct:description xml:lang="en">The schema that the distribution conforms to that is format and technology dependent.</dct:description>
        <rdfs:label>distribution conforms to shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="Distribution-isDistributionOf">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="https://ekgf.github.io/dprod/isDistributionOf"/>
        <sh:class rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <dct:description xml:lang="en">The dataset that this distribution makes available.</dct:description>
        <rdfs:label>distribution is distribution of shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="Distribution-format">
        <rdfs:isDefinedBy rdf:resource=""/>
        <sh:path rdf:resource="http://purl.org/dc/terms/format"/>
        <dct:description xml:lang="en">The file format of the distribution.</dct:description>
        <rdfs:label>distribution format shape</rdfs:label>
      </sh:PropertyShape>
    </sh:property>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="DataProductLifecycleStatusShape">
    <rdfs:label>data product lifecycle status shape</rdfs:label>
    <dct:description xml:lang="en">The development status of the data product taken from a controlled list (e.g. Ideation, Design, Build, Deploy, Consume).</dct:description>
    <sh:targetClass rdf:resource="https://ekgf.github.io/dprod/DataProductLifecycleStatus"/>
    <rdfs:isDefinedBy rdf:resource=""/>
  </sh:NodeShape>
</rdf:RDF>
