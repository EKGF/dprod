{
  "@context": [
    "https://www.omg.org/spec/DPROD/dprod-context.jsonld",
    {
      "reg": "https://www.region.taxonomy/v/1/"
    }
  ],
  "@id": "https://data.org/policy/56456df-dfg-34535345-5545",
  "@type": "odrl:Agreement",
  "odrl:permission": [
    {
      "odrl:target": { "@id": "https://data.org/data-product/equity-trade-xxx" },
      "odrl:assigner": { "@id": "https://schema.org/person/AdamSmith" },
      "odrl:assignee": {
        "@id": "https://example.org/DataDepartment/emea-and-apac-staff",
        "@type": "odrl:PartyCollection",
        "odrl:source": { "@id": "https://example.org/DataDepartment" },
        "odrl:refinement": [
          {
            "odrl:leftOperand": { "@id": "odrl:spatial" },
            "odrl:operator": { "@id": "odrl:isAnyOf" },
            "odrl:rightOperand": [
              { "@id": "reg:EMEA" },
              { "@id": "reg:APAC" }
            ],
            "dct:description": "Permission to read all the datasets of the product if the user is working inside EMEA or APAC"
          }
        ]
      },
      "odrl:action": { "@id": "odrl:use" }
    }
  ]
}
