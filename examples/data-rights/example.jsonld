{
  "@context": [
    "https://ekgf.org/dprod/spec/develop/dprod-simple.jsonld",
    { "reg": "https://www.region.taxonomy/v/1/" }
  ],
  "id": "https://data.org/policy/56456df-dfg-34535345-5545",
  "type": "Agreement",
  "permission": [
    {
      "target": { "id": "https://data.org/data-product/equity-trade-xxx" },
      "assigner": { "id": "https://schema.org/person/AdamSmith" },
      "assignee": {
        "id": "https://example.org/DataDepartment/emea-and-apac-staff",
        "type": "PartyCollection",
        "source": { "id": "https://example.org/DataDepartment" },
        "refinement": [
          {
            "leftOperand": "odrl:spatial",
            "operator": "isAnyOf",
            "rightOperand": [
              { "id": "reg:EMEA" },
              { "id": "reg:APAC" }
            ],
            "description": "Permission to read all the datasets of the product if the user is working inside EMEA or APAC"
          }
        ]
      },
      "action": "use"
    }
  ]
}
