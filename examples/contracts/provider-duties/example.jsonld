{
  "@context": [
    "https://ekgf.org/dprod/spec/develop/dprod-simple.jsonld",
    { "ex": "https://example.org/" }
  ],
  "id": "ex:riskMetricsOffer",
  "type": "DataOffer",
  "profile": "https://ekgf.org/dprod/spec/develop/",
  "assigner": "ex:dataPlatformTeam",
  "target": "ex:riskMetrics",
  "obligation": [
    {
      "type": "Duty",
      "label": "Delivery: every day at 07:00, within 30 minutes",
      "subjectOfDuty": "ex:dataPlatformTeam",
      "action": "ex:deliver",
      "schedule": {
        "id": "ex:dailyAt0700",
        "type": "Schedule",
        "conformsTo": "dprod:Rfc5545ScheduleFormat",
        "scheduleExpression": "DTSTART;TZID=Europe/London:20260101T070000\nRRULE:FREQ=DAILY"
      },
      "deadline": { "@value": "PT30M", "type": "xsd:duration" }
    },
    {
      "type": "Duty",
      "label": "Schema conformance",
      "subjectOfDuty": "ex:dataPlatformTeam",
      "action": "ex:conformTo",
      "target": "ex:riskMetricsSchema"
    },
    {
      "type": "Duty",
      "label": "Change notification",
      "subjectOfDuty": "ex:dataPlatformTeam",
      "action": "ex:notify",
      "target": "ex:schemaChanges",
      "ex:noticePeriod": { "@value": "P14D", "type": "xsd:duration" }
    },
    {
      "type": "Duty",
      "label": "Quality: data must be real-time",
      "subjectOfDuty": "ex:dataPlatformTeam",
      "action": {
        "rdf:value": { "id": "ex:conformTo" },
        "refinement": {
          "type": "Constraint",
          "leftOperand": {
            "id": "ex:timeliness",
            "operandSource": "stateSource",
            "operandProperty": "ex:timeliness"
          },
          "operator": "eq",
          "rightOperand": { "id": "ex:realtime" }
        }
      }
    }
  ]
}
